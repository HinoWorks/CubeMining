  m_Script: {fileID: 11500000, guid: ca32c5d5643e5405a82d735165dd8041, type: 3}
  m_Name: SO_PickaxePowerData
  m_EditorClassIdentifier: Assembly-CSharp::SO_PickaxePowerData
  pickaxePowerBases:
  - index: 1
    skillName: Titan Pickaxe
    description: Summons a giant pickaxe to smash the current mining area. (Damage
      scales with Pickaxe Power)
    icon: {fileID: 21300000, guid: 709a1223eb6714bffb8bdae83eaf1684, type: 3}
    unlockLevel: 1
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 1552349253804401439, guid: 0e9b67a3e0aa34316a2e2bbb0c9b810f, type: 3}
  - index: 2
    skillName: Meteor Bomber
    description: Drops a powerful Bomb Block from above. (Damage scales with Pickaxe
      Power)
    icon: {fileID: 21300000, guid: 16bd12464a9aa402db810694dd188923, type: 3}
    unlockLevel: 5
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 7060867681397398350, guid: a2612511c492244ccacccb2c3bf15d9c, type: 3}
  - index: 3
    skillName: Horizon Laser
    description: Fires a laser that sweeps across the current layer. (Damage scales
      with Pickaxe Power)
    icon: {fileID: 21300000, guid: 18ee2e26897104df1a19bce2ff4c4838, type: 3}
    unlockLevel: 8
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 400877379012588226, guid: 029c19b5888864504b74e6abe7d82252, type: 3}
  - index: 4
    skillName: Collect Flower
    description: Spawns a flower that attracts and gathers nearby ores.
    icon: {fileID: 21300000, guid: 3e4c49bb0a89e4b21831fd5cf1ddcfad, type: 3}
    unlockLevel: 13
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 5558064007501070093, guid: 97e40551d1b064b76a6f0012f47a26e5, type: 3}
  - index: 5
    skillName: Arrow Volley
    description: Fires a volley of arrows at random blocks. (Damage scales with Pickaxe
      Power)
    icon: {fileID: 21300000, guid: 4accd5296491b4e64b7cab752feaf001, type: 3}
    unlockLevel: 16
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 4866347856038464369, guid: 8afe324a251e54584bdff968cd5bce8d, type: 3}
  - index: 6
    skillName: Chain Lightning
    description: Fires lightning from the 4 corners toward the cursor, damaging blocks
      in its path. (Damage scales with Pickaxe Power)
    icon: {fileID: 21300000, guid: 128462cd193904c918b9d7a082820ead, type: 3}
    unlockLevel: 20
    blockCount: 5
    CD: 5
    maxLevel: 3
    pf: {fileID: 1214965774706709456, guid: 07aae9ee3359e44f383c381555ae8de7, type: 3}
  - index: 7
    skillName: Geo Dowsing
    description: Converts dirt blocks on screen into ore blocks.
    icon: {fileID: 21300000, guid: 364c3ccc9fe8c40e09296355fe6aeac6, type: 3}
    unlockLevel: 25
    blockCount: 5
    CD: 5
    maxLevel: 3
    pf: {fileID: 8235290486800529160, guid: 59342e19ef9714670804572a3556a06b, type: 3}
  - index: 8
    skillName: Triple Quake
    description: Triggers a shockwave around the cursor, striking in a circular area
      3 times. (Damage scales with Pickaxe Power)
    icon: {fileID: 21300000, guid: ec04bd256232443549698d518a28f426, type: 3}
    unlockLevel: 30
    blockCount: 5
    CD: 5
    maxLevel: 3
    pf: {fileID: 2383101912220292839, guid: 67cdeca9feb7e40a381994916737df5b, type: 3}
  - index: 999
    skillName: Overdrive
    description: Temporarily boosts all pickaxe stats.
    icon: {fileID: 0}
    unlockLevel: 999999
    blockCount: 15
    CD: 5
    maxLevel: 3
    pf: {fileID: 747459983867244030, guid: d7e5f5af4f6984d5480e7e543314db27, type: 3}
